# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# =============================================================================
# HACKATHON: Files judges don't need to see
# =============================================================================

# Setup and documentation files (keep for reference)
SETUP.md
FILECOIN_SETUP.md
challenge-recommendations.txt
pl-genesis-submission.md

# Test files
poa-test.txt
*.test.*

# Private keys and sensitive data (already covered by .env* but being explicit)
*private*.json
*wallet*.json
mnemonic*.txt

# Local development files
.local/
temp/
*.tmp

# IDE files
.vscode/
.idea/
*.swp
*.swo

# =============================================================================
# KEEP THESE FILES (judges need to see)
# =============================================================================
# src/ - Source code
# public/ - Static assets  
# package.json - Dependencies
# README.md - Project description
# supabase-schema.sql - Database structure
# .env.example - Configuration template
# =============================================================================
